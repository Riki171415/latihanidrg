# Public Auth URL is populated by neon deploy. Do not guess from the REST URL.
NEON_AUTH_BASE_URL=
NEON_DATA_API_URL=https://ep-spring-water-bcufhjhz.apirest.c-16.us-east-1.aws.neon.tech/neondb/rest/v1
